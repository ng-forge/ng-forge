{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The package declares `"type": "module"` and is consumed through its
    // `exports` map, so emit must be real ESM. Relative specifiers carry
    // explicit `.js` extensions for this reason.
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "importHelpers": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
