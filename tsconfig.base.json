{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@ng-forge/dynamic-forms": ["./packages/dynamic-forms/src/index.ts"],
      "@ng-forge/dynamic-forms/internal": ["./packages/dynamic-forms/internal/src/public_api.ts"],
      "@ng-forge/dynamic-forms/integration": ["./packages/dynamic-forms/integration/src/public_api.ts"],
      "@ng-forge/dynamic-forms/schema": ["./packages/dynamic-forms/schema/src/public_api.ts"],
      "@ng-forge/dynamic-forms-bootstrap": ["./packages/dynamic-forms-bootstrap/src/index.ts"],
      "@ng-forge/dynamic-forms-bootstrap/shared": ["./packages/dynamic-forms-bootstrap/shared/public-api.ts"],
      "@ng-forge/dynamic-forms-bootstrap/lazy/*": [
        "./packages/dynamic-forms-bootstrap/lazy/*/index.ts",
        "./packages/dynamic-forms-bootstrap/src/lib/fields/*/index.ts"
      ],
      "@ng-forge/dynamic-forms-ionic": ["./packages/dynamic-forms-ionic/src/index.ts"],
      "@ng-forge/dynamic-forms-ionic/shared": ["./packages/dynamic-forms-ionic/shared/public-api.ts"],
      "@ng-forge/dynamic-forms-ionic/lazy/*": [
        "./packages/dynamic-forms-ionic/lazy/*/index.ts",
        "./packages/dynamic-forms-ionic/src/lib/fields/*/index.ts"
      ],
      "@ng-forge/dynamic-forms-material": ["./packages/dynamic-forms-material/src/index.ts"],
      "@ng-forge/dynamic-forms-material/shared": ["./packages/dynamic-forms-material/shared/public-api.ts"],
      "@ng-forge/dynamic-forms-material/lazy/*": [
        "./packages/dynamic-forms-material/lazy/*/index.ts",
        "./packages/dynamic-forms-material/src/lib/fields/*/index.ts"
      ],
      "@ng-forge/dynamic-forms-primeng": ["./packages/dynamic-forms-primeng/src/index.ts"],
      "@ng-forge/dynamic-forms-primeng/shared": ["./packages/dynamic-forms-primeng/shared/public-api.ts"],
      "@ng-forge/dynamic-forms-primeng/lazy/*": [
        "./packages/dynamic-forms-primeng/lazy/*/index.ts",
        "./packages/dynamic-forms-primeng/src/lib/fields/*/index.ts"
      ],
      "@ng-forge/dynamic-form-mcp": ["./packages/dynamic-form-mcp/src/index.ts"],
      "@ng-forge/openapi-generator": ["./packages/openapi-generator/src/index.ts"],
      "@ng-forge/workspace-plugin": ["./tools/workspace-plugin/src/index.ts"],
      "@ng-forge/examples-material": ["./internal/examples-material/src/index.ts"],
      "@ng-forge/examples-bootstrap": ["./internal/examples-bootstrap/src/index.ts"],
      "@ng-forge/examples-primeng": ["./internal/examples-primeng/src/index.ts"],
      "@ng-forge/examples-ionic": ["./internal/examples-ionic/src/index.ts"],
      "@ng-forge/examples-shared-testing": ["./internal/examples-shared-testing/src/index.ts"],
      "@ng-forge/examples-shared-ui": ["./internal/examples-shared-ui/src/index.ts"],
      "@ng-forge/sandbox-harness": ["./internal/sandbox-harness/src/index.ts"],
      "@ng-forge/sandbox-adapter-material": ["./internal/sandbox-adapter-material/src/index.ts"],
      "@ng-forge/sandbox-adapter-bootstrap": ["./internal/sandbox-adapter-bootstrap/src/index.ts"],
      "@ng-forge/sandbox-adapter-primeng": ["./internal/sandbox-adapter-primeng/src/index.ts"],
      "@ng-forge/sandbox-adapter-ionic": ["./internal/sandbox-adapter-ionic/src/index.ts"],
      "@ng-forge/examples-shared-testing/playwright-config": ["./internal/examples-shared-testing/src/lib/playwright-config.ts"],
      "@ng-forge/examples-shared-testing/perf": ["./internal/examples-shared-testing/src/lib/perf/index.ts"],
      "@ng-forge/examples-shared-testing/perf-spec": ["./internal/examples-shared-testing/src/lib/perf-spec.ts"],
      "@ng-forge/examples-shared-testing/id-collision-spec": [
        "./internal/examples-shared-testing/src/lib/id-collision/id-collision-spec.ts"
      ],
      "@ng-forge/styling": ["./internal/styling/src/index.ts"],
      "@ng-forge/dynamic-forms/testing": ["./packages/dynamic-forms/testing/src/public_api.ts"],
      "@ng-forge/utils": ["./internal/utils/src/index.ts"],
      "@ng-forge/dynamic-forms-validation": ["./internal/dynamic-forms-validation/index.ts"],
      "@ng-forge/dynamic-forms-validation/schema-only": ["./internal/dynamic-forms-validation/validate/src/index.ts"],
      "@ng-forge/dynamic-forms-cli": ["./packages/dynamic-forms-cli/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
