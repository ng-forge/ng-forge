# Playwright image with pnpm support
# Extends official Playwright image and enables corepack for pnpm

ARG PLAYWRIGHT_VERSION=1.59.1
FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble

# Newer Playwright images ship a Node without corepack, so install it first
RUN npm install -g corepack && corepack enable && corepack prepare pnpm@latest --activate

# Verify installation
RUN pnpm --version
