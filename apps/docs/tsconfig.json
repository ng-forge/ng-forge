{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "target": "es2022",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "emitDecoratorMetadata": false,
    "module": "preserve",
    "lib": ["dom", "es2022"],
    "paths": {
      "@ng-forge/dynamic-forms": ["../../packages/dynamic-forms/src/index.ts"],
      "@ng-forge/dynamic-forms/internal": ["../../packages/dynamic-forms/internal/src/public_api.ts"],
      "@ng-forge/dynamic-forms/integration": ["../../packages/dynamic-forms/integration/src/public_api.ts"],
      "@ng-forge/dynamic-forms/schema": ["../../packages/dynamic-forms/schema/src/public_api.ts"],
      "@ng-forge/dynamic-forms/testing": ["../../packages/dynamic-forms/testing/src/public_api.ts"],
      "@ng-forge/dynamic-forms-bootstrap": ["../../dist/packages/dynamic-forms-bootstrap"],
      "@ng-forge/dynamic-forms-bootstrap/shared": ["../../dist/packages/dynamic-forms-bootstrap/shared"],
      "@ng-forge/dynamic-forms-bootstrap/lazy/*": ["../../dist/packages/dynamic-forms-bootstrap/lazy/*"],
      "@ng-forge/dynamic-forms-ionic": ["../../dist/packages/dynamic-forms-ionic"],
      "@ng-forge/dynamic-forms-ionic/shared": ["../../dist/packages/dynamic-forms-ionic/shared"],
      "@ng-forge/dynamic-forms-ionic/lazy/*": ["../../dist/packages/dynamic-forms-ionic/lazy/*"],
      "@ng-forge/dynamic-forms-material": ["../../dist/packages/dynamic-forms-material"],
      "@ng-forge/dynamic-forms-material/shared": ["../../dist/packages/dynamic-forms-material/shared"],
      "@ng-forge/dynamic-forms-material/lazy/*": ["../../dist/packages/dynamic-forms-material/lazy/*"],
      "@ng-forge/dynamic-forms-primeng": ["../../dist/packages/dynamic-forms-primeng"],
      "@ng-forge/dynamic-forms-primeng/shared": ["../../dist/packages/dynamic-forms-primeng/shared"],
      "@ng-forge/dynamic-forms-primeng/lazy/*": ["../../dist/packages/dynamic-forms-primeng/lazy/*"],
      "@ng-forge/sandbox-harness": ["../../internal/sandbox-harness/src/index.ts"],
      "@ng-forge/styling": ["../../dist/internal/styling"],
      "@ng-forge/examples-shared-ui": ["../../internal/examples-shared-ui/src/index.ts"],
      "@ng-forge/examples-material": ["../../dist/internal/examples-material"],
      "@ng-forge/examples-bootstrap": ["../../dist/internal/examples-bootstrap"],
      "@ng-forge/examples-primeng": ["../../dist/internal/examples-primeng"],
      "@ng-forge/examples-ionic": ["../../dist/internal/examples-ionic"],
      "@ng-forge/sandbox-adapter-material": ["../../dist/internal/sandbox-adapter-material"],
      "@ng-forge/sandbox-adapter-bootstrap": ["../../dist/internal/sandbox-adapter-bootstrap"],
      "@ng-forge/sandbox-adapter-primeng": ["../../dist/internal/sandbox-adapter-primeng"],
      "@ng-forge/sandbox-adapter-ionic": ["../../dist/internal/sandbox-adapter-ionic"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
