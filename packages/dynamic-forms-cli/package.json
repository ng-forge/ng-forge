{
  "name": "@ng-forge/dynamic-forms-cli",
  "version": "1.1.0",
  "description": "Command-line validator for @ng-forge/dynamic-forms FormConfig objects",
  "type": "module",
  "license": "MIT",
  "author": "ng-forge",
  "homepage": "https://ng-forge.com/dynamic-forms/ai-integration",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ng-forge/ng-forge.git",
    "directory": "packages/dynamic-forms-cli"
  },
  "bugs": {
    "url": "https://github.com/ng-forge/ng-forge/issues"
  },
  "keywords": [
    "angular",
    "forms",
    "dynamic-forms",
    "validation",
    "cli",
    "lint",
    "ng-forge"
  ],
  "bin": {
    "ng-forge-validate": "./bin/ng-forge-validate.js"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "dependencies": {
    "@ng-forge/dynamic-forms-zod": "1.1.0",
    "commander": "^14.0.3",
    "ts-morph": "^28.0.0",
    "zod": "^3.25.76"
  }
}
