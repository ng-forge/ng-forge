{
  "name": "dynamic-forms-zod",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/dynamic-forms-zod/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["{projectRoot}", "dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/dynamic-forms-zod",
        "main": "packages/dynamic-forms-zod/src/index.ts",
        "tsConfig": "packages/dynamic-forms-zod/tsconfig.lib.json",
        "assets": ["packages/dynamic-forms-zod/README.md", "packages/dynamic-forms-zod/LICENSE"],
        "additionalEntryPoints": [
          "packages/dynamic-forms-zod/material/src/index.ts",
          "packages/dynamic-forms-zod/bootstrap/src/index.ts",
          "packages/dynamic-forms-zod/primeng/src/index.ts",
          "packages/dynamic-forms-zod/ionic/src/index.ts",
          "packages/dynamic-forms-zod/validate/src/index.ts"
        ]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "packages/dynamic-forms-zod/vitest.config.mts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "smoke": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": true,
      "inputs": [
        "{workspaceRoot}/dist/{projectRoot}/**/*.js",
        "{workspaceRoot}/dist/{projectRoot}/package.json",
        "{workspaceRoot}/scripts/package-smoke-test.mjs"
      ],
      "options": {
        "command": "node scripts/package-smoke-test.mjs dist/packages/dynamic-forms-zod",
        "cwd": "{workspaceRoot}"
      }
    },
    "api-check": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": true,
      "inputs": [
        "{workspaceRoot}/dist/{projectRoot}/src/**/*.d.ts",
        "{workspaceRoot}/dist/{projectRoot}/validate/**/*.d.ts",
        "{projectRoot}/api-extractor.json",
        "{projectRoot}/api-extractor.validate.json",
        "{workspaceRoot}/config/api-extractor.base.json",
        "{workspaceRoot}/etc/dynamic-forms-zod.api.md",
        "{workspaceRoot}/etc/dynamic-forms-zod-validate.api.md",
        "{workspaceRoot}/scripts/api-check.mjs",
        "{workspaceRoot}/scripts/normalize-api-unions.mjs"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node scripts/api-check.mjs packages/dynamic-forms-zod/api-extractor.json packages/dynamic-forms-zod/api-extractor.validate.json"
      }
    },
    "api-update": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "nx run dynamic-forms-zod:build --skip-nx-cache",
          "api-extractor run --local --config packages/dynamic-forms-zod/api-extractor.json",
          "api-extractor run --local --config packages/dynamic-forms-zod/api-extractor.validate.json",
          "node scripts/normalize-api-unions.mjs etc/dynamic-forms-zod.api.md etc/dynamic-forms-zod-validate.api.md"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
