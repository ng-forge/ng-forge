{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "material/src/**/*.ts",
    "bootstrap/src/**/*.ts",
    "primeng/src/**/*.ts",
    "ionic/src/**/*.ts",
    "validate/src/**/*.ts"
  ],
  // Test globs are NOT scoped to `src/` - the adapter entry points
  // (material/, bootstrap/, ...) carry their own specs, and scoping the
  // excludes to src/ shipped those specs in the published package.
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.test.tsx",
    "**/*.spec.tsx",
    "**/__tests__/**"
  ]
}
